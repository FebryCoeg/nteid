rules_version = '2';
// Tempel di Firebase Console > Firestore Database > Rules, lalu Publish.
// Hanya koleksi "proposals", "locks", dan "buildProposals" yang boleh diakses; semua yang lain tertutup.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'febririansyah1999@gmail.com';
    }
    function validTeam(t) {
      return t is map
        && t.keys().hasOnly(['name', 'members', 'roles', 'why'])
        && t.name is string && t.name.size() >= 1 && t.name.size() <= 40
        && t.members is list && t.members.size() >= 2 && t.members.size() <= 4
        && t.roles is list && t.roles.size() <= 4
        && t.why is string && t.why.size() <= 300;
    }
    function validCredit(c) {
      return c is map
        && c.keys().hasOnly(['name', 'url'])
        && c.name is string && c.name.size() >= 1 && c.name.size() <= 40
        && c.url is string && c.url.size() <= 200
        && (c.url == '' || c.url.matches('^https://((www|m|web|mbasic)[.])?facebook[.]com/[^ ]+$') || c.url.matches('^https://(www[.])?fb[.]com/[^ ]+$'));
    }
    // "key" = anggota tim diurutkan dan digabung dengan titik; harus cocok dengan daftar anggota.
    function validKey(d) {
      return d.key is string && d.key.size() <= 200
        && d.key.matches('^[A-Za-z0-9_.-]+$')
        && d.key.split('[.]').size() == d.team.members.size()
        && d.key.split('[.]').toSet() == d.team.members.toSet();
    }
    function lockPath(d) {
      return /databases/$(database)/documents/locks/$(d.esper + '__' + d.key);
    }
    function validProposal(d) {
      return d.keys().hasOnly(['uid', 'name', 'esper', 'key', 'team', 'credit', 'status', 'createdAt'])
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() <= 80
        && d.esper is string && d.esper.size() >= 1 && d.esper.size() <= 64
        && d.status == 'pending'
        && d.createdAt == request.time
        && validTeam(d.team)
        && validCredit(d.credit)
        && validKey(d);
    }

    // tim opsional di dalam build: 2 sampai 4 anggota, peran maksimal 4
    function validBuildTeam(t) {
      return t is map
        && t.keys().hasOnly(['members', 'roles'])
        && t.members is list && t.members.size() >= 2 && t.members.size() <= 4
        && t.roles is list && t.roles.size() <= 4;
    }
    function validBuild(b) {
      return b is map
        && b.keys().hasOnly(['name', 'team', 'arcs', 'sets', 'stats', 'sub', 'awks', 'skills', 'rot', 'rotation', 'why'])
        && b.name is string && b.name.size() >= 1 && b.name.size() <= 40
        && (!('team' in b) || validBuildTeam(b.team))
        && b.arcs is list && b.arcs.size() >= 1 && b.arcs.size() <= 4
        && b.sets is list && b.sets.size() <= 3
        && b.stats is list && b.stats.size() >= 1 && b.stats.size() <= 3
        && b.sub is list && b.sub.size() <= 4
        && b.awks is list && b.awks.size() <= 6
        && b.skills is list && b.skills.size() <= 4
        && (!('rot' in b) || (b.rot is list && b.rot.size() <= 24))
        && (!('rotation' in b) || (b.rotation is string && b.rotation.size() <= 500))
        && b.why is string && b.why.size() <= 300;
    }
    function validBuildProposal(d) {
      return d.keys().hasOnly(['uid', 'name', 'esper', 'build', 'credit', 'status', 'createdAt'])
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() <= 80
        && d.esper is string && d.esper.size() >= 1 && d.esper.size() <= 64
        && d.status == 'pending'
        && d.createdAt == request.time
        && validBuild(d.build)
        && validCredit(d.credit);
    }

    match /proposals/{id} {
      // id dokumen wajib "<uid>_<esper>": satu usulan per pengguna per karakter, SEKALI SAJA.
      // Tidak ada aturan update/delete untuk pemilik, jadi usulan tidak bisa diganti atau dihapus lalu dikirim ulang.
      // Dikirim bersama dokumen kunci (locks) dalam satu batch: tim dengan anggota sama hanya bisa diusulkan sekali.
      allow create: if signedIn()
        && id == request.auth.uid + '_' + request.resource.data.esper
        && validProposal(request.resource.data)
        && existsAfter(lockPath(request.resource.data))
        && getAfter(lockPath(request.resource.data)).data.uid == request.auth.uid;

      // Admin hanya boleh mengubah status dan menambahkan reviewedAt.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected', 'pending'];

      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Kunci tim kembar: dokumen "<esper>__<anggota diurutkan>" hanya bisa dibuat sekali (siapa cepat dia dapat).
    match /locks/{lid} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
    }

    // Usulan lengkap (tim opsional, Arc, set, stat, Awakening, skill): satu per pengguna per karakter, sekali saja (id "<uid>_<esper>"), tanpa update/delete pemilik.
    match /buildProposals/{id} {
      allow create: if signedIn()
        && id == request.auth.uid + '_' + request.resource.data.esper
        && validBuildProposal(request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected', 'pending'];
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
