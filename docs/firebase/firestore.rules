rules_version = '2';
// Tempel di Firebase Console > Firestore Database > Rules, lalu Publish.
// Hanya koleksi "proposals" yang boleh diakses; semua yang lain tertutup.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'febririansyah1999@gmail.com';
    }
    function validTeam(t) {
      return t is map
        && t.keys().hasOnly(['name', 'members', 'roles', 'why'])
        && t.name is string && t.name.size() >= 1 && t.name.size() <= 40
        && t.members is list && t.members.size() >= 2 && t.members.size() <= 4
        && t.roles is list && t.roles.size() <= 4
        && t.why is string && t.why.size() <= 300;
    }
    function validCredit(c) {
      return c is map
        && c.keys().hasOnly(['name', 'url'])
        && c.name is string && c.name.size() >= 1 && c.name.size() <= 40
        && c.url is string && c.url.size() <= 200
        && (c.url == '' || c.url.matches('^https://((www|m|web|mbasic)[.])?facebook[.]com/[^ ]+$') || c.url.matches('^https://(www[.])?fb[.]com/[^ ]+$'));
    }
    function validProposal(d) {
      return d.keys().hasOnly(['uid', 'name', 'esper', 'team', 'credit', 'status', 'createdAt'])
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() <= 80
        && d.esper is string && d.esper.size() >= 1 && d.esper.size() <= 64
        && d.status == 'pending'
        && d.createdAt == request.time
        && validTeam(d.team)
        && validCredit(d.credit);
    }

    match /proposals/{id} {
      // id dokumen wajib "<uid>_<esper>": satu usulan per pengguna per Esper (menekan spam).
      allow create: if signedIn()
        && id == request.auth.uid + '_' + request.resource.data.esper
        && validProposal(request.resource.data);

      // Pemilik boleh mengganti usulannya sendiri (tetap berstatus pending).
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.esper
        && validProposal(request.resource.data);

      // Admin hanya boleh mengubah status dan menambahkan reviewedAt.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'rejected', 'pending'];

      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
